# 必填：飞书企业自建应用
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_me

# 可选：启用公网网页端后填写
CODEX_HISTORY_URL=https://your-domain.example/api/sync
CODEX_HISTORY_SYNC_TOKEN=replace_with_a_long_random_token

# 可选：HTTPS 同步失败时的 SSH 备用通道
CODEX_HISTORY_SSH_HOST=root@your-server-ip
CODEX_HISTORY_SSH_KEY=C:\path\to\your-private-key.pem

# 可选：大文件同步目录
CODEX_LARGE_FILE_DIR=D:\BaiduSyncdisk\Agent Disk

# 可选：自动创建网页项目时使用的根目录
CODEX_PROJECTS_ROOT=D:\CodexProjects
